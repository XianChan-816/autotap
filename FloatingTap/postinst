#!/bin/bash
# FloatingTap postinst — v2.5
# BackboardInject 注入 backboardd（Dopamine/ellekit 自动加载），无需 launchctl。
#   · 清理 v2.0 时代遗留的独立 daemon（floatingtapd，已废弃）
#   · 初始化分级开关 ftb_stage（默认 1 = 最保守的可用档）
#   · 清空自愈保险 ftb_guard，给新版本一次干净的尝试机会
LOG="/tmp/backboard_inject.log"
echo "[postinst] v2.5 start" >> "$LOG" 2>/dev/null || true

LC="/var/jb/usr/bin/launchctl"
[ -x "$LC" ] || LC="launchctl"
"$LC" bootout system/com.floatingtap.daemon 2>>"$LOG" || true
rm -f /var/jb/usr/libexec/floatingtapd 2>>"$LOG" || true
rm -f /var/jb/Library/LaunchDaemons/com.floatingtap.daemon.plist 2>>"$LOG" || true
rm -f /var/jb/tmp/floatingtapd.sock 2>>"$LOG" || true

mkdir -p /var/jb/tmp 2>/dev/null || true

# 分级开关：v2.5 仍强制重置为 3（装 hook 但纯透传，先证明 hook 安全再往上爬）
# 无条件覆盖：旧版遗留的 stage=4/5 会让新版跳过纯透传验证，必须压回 3。
echo 3 > /var/jb/tmp/ftb_stage 2>/dev/null || true
echo 3 > /tmp/ftb_stage 2>/dev/null || true
chmod 666 /var/jb/tmp/ftb_stage /tmp/ftb_stage 2>/dev/null || true

# 自愈保险清零：新版本 = 新机会
rm -f /var/jb/tmp/ftb_guard /tmp/ftb_guard 2>/dev/null || true

echo "[postinst] v2.5 done (stage=$(cat /var/jb/tmp/ftb_stage 2>/dev/null || cat /tmp/ftb_stage 2>/dev/null || echo '?'), guard cleared)" >> "$LOG" 2>/dev/null || true
exit 0
