#!/bin/bash
# FloatingTap postinst — 安装后启动 floatingtapd 独立注入 daemon
# ⚠️ daemon 崩不影响系统（独立进程）；launchctl bootstrap 失败不阻塞安装。
# rootless 下 LaunchDaemons plist 实际位于 /var/jb/Library/LaunchDaemons/

PLIST="/var/jb/Library/LaunchDaemons/com.floatingtap.daemon.plist"

# 先卸载旧实例（幂等），再加载新的
launchctl bootout system/com.floatingtap.daemon 2>/dev/null
launchctl bootstrap system "$PLIST" 2>/dev/null
launchctl kickstart -k system/com.floatingtap.daemon 2>/dev/null

echo "floatingtapd: postinst done" >> /tmp/floatingtap_daemon.log 2>/dev/null || true

exit 0
