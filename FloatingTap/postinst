#!/bin/bash
# FloatingTap postinst — v2.1
# BackboardInject 是注入 backboardd 的 tweak（由 Dopamine/ellekit 自动加载），
# 无需 launchctl。清理旧版独立 daemon（floatingtapd，v2.0 时代遗留，已废弃）。
LOG="/tmp/backboard_inject.log"
echo "[postinst] v2.1: cleaning old floatingtapd daemon" >> "$LOG" 2>/dev/null || true

LC="/var/jb/usr/bin/launchctl"
[ -x "$LC" ] || LC="launchctl"
"$LC" bootout system/com.floatingtap.daemon 2>>"$LOG" || true
rm -f /var/jb/usr/libexec/floatingtapd 2>>"$LOG" || true
rm -f /var/jb/Library/LaunchDaemons/com.floatingtap.daemon.plist 2>>"$LOG" || true
rm -f /var/jb/tmp/floatingtapd.sock 2>>"$LOG" || true

echo "[postinst] v2.1 done (BackboardInject auto-loads into backboardd)" >> "$LOG" 2>/dev/null || true
exit 0
