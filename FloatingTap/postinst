#!/bin/bash
# FloatingTap postinst — v2.7
# BackboardInject 注入 backboardd（Dopamine/ellekit 自动加载），无需 launchctl。
#
# ⚠️ 路径映射（v2.5 踩坑实录）：
#     注入 dylib 内的绝对路径会被 rootless 运行时自动前缀 jbroot：
#        dylib "/tmp/X"        -> <jbroot>/tmp/X       == shell 的 /var/jb/tmp/X  ✓ 同一文件
#        dylib "/var/jb/tmp/X" -> <jbroot>/var/jb/tmp/X                          ✗ shell 够不到
#     所以 shell 侧一律用 /var/jb/tmp/，dylib 侧一律用 /tmp/。
#     v2.5 的 guard 就是写进了那个死角，postinst 清不掉，导致每次开机都被自愈保险禁用。
# v2.7 新坑：/var/jb/tmp 重启会被清空，而 ftb_stage 是唯一不被 dylib 重新生成的文件，
#     放 /tmp 会导致每次重启回退默认 stage 3。现已把 stage 文件移到 /var/jb/Library/FloatingTap/
#     （持久目录），shell 侧用 /var/jb/Library/FloatingTap/ftb_stage，dylib 侧用 /Library/FloatingTap/ftb_stage。
LOG="/var/jb/tmp/backboard_inject.log"
echo "[postinst] v2.6 start" >> "$LOG" 2>/dev/null || true

LC="/var/jb/usr/bin/launchctl"
[ -x "$LC" ] || LC="launchctl"
"$LC" bootout system/com.floatingtap.daemon 2>>"$LOG" || true
rm -f /var/jb/usr/libexec/floatingtapd 2>>"$LOG" || true
rm -f /var/jb/Library/LaunchDaemons/com.floatingtap.daemon.plist 2>>"$LOG" || true
rm -f /var/jb/tmp/floatingtapd.sock /var/jb/tmp/floatingtap_cmd /var/jb/tmp/floatingtap_bbok 2>>"$LOG" || true

mkdir -p /var/jb/tmp 2>/dev/null || true
mkdir -p /var/jb/Library/FloatingTap 2>/dev/null || true

# 分级开关：v2.7 起 stage 文件移到持久目录 /var/jb/Library/FloatingTap/（/var/jb/tmp 重启清空，
# stage 是唯一不自愈的文件 -> 放 /tmp 会每次重启回退默认 3）。v2.7.1 起默认 5（装完即高频）。
echo 5 > /var/jb/Library/FloatingTap/ftb_stage 2>/dev/null || true
chmod 666 /var/jb/Library/FloatingTap/ftb_stage 2>/dev/null || true

# 自愈保险清零。guard 现在带 build id，新构建本就自动作废，这里只是顺手扫干净。
# 三处都清：正确位置、v2.5 双前缀死角、以及真实 /tmp（旧版误写过）。
rm -f /var/jb/tmp/ftb_guard 2>/dev/null || true
rm -f /var/jb/var/jb/tmp/ftb_guard /var/jb/var/jb/tmp/ftb_stage 2>/dev/null || true
rm -f /tmp/ftb_guard 2>/dev/null || true

# 握手标记：dylib 侧读 "/tmp/ftb_pi"，若能读到这里写的时间戳，
# 说明两侧确实在同一个文件视图（路径映射假设成立）。
date +%s > /var/jb/tmp/ftb_pi 2>/dev/null || true
chmod 666 /var/jb/tmp/ftb_pi 2>/dev/null || true

echo "[postinst] v2.7 done (stage=$(cat /var/jb/Library/FloatingTap/ftb_stage 2>/dev/null || echo '?'), guard cleared, marker written)" >> "$LOG" 2>/dev/null || true
exit 0
