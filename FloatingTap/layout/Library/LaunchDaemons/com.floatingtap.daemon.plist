<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.floatingtap.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/var/jb/usr/libexec/floatingtapd</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>com.floatingtap.daemon</key>
		<true/>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/var/jb/tmp/floatingtapd.out</string>
	<key>StandardErrorPath</key>
	<string>/var/jb/tmp/floatingtapd.err</string>
</dict>
</plist>
